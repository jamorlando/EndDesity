# ====================================================================
# 团队工作日志与智能复盘管理系统 —— 后端环境变量模板
# 复制为 .env 后按实际环境填写；.env 已加入 .gitignore，严禁提交明文密钥。
# ====================================================================

# 数据库连接串 (asyncmy 异步驱动)
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3306/end_design_db

# JWT 签名密钥 (生产环境务必更换为随机长字符串)
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 大模型网关 (mock 为本地高仿真降级沙箱，保证断网演示 100% 稳定)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# 允许跨域的前端来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173